<div class="row user-file-form">
  <div class="col-md-6">
    <%= hidden_field_tag :filetype, filetype %>
    <div class="input-group mb-2">
      <%= file_field_tag :content, class: "form-control", accept: "#{filetype}/*", "aria-label": t("bootsy.action.choose_file") %>
      <%= button_tag t("bootsy.action.insert"), type: "button", class: "btn btn-primary" %>
    </div>
  </div>
</div>